+def _tpr_diag_signature(value: Any) -> tuple[str, int]:
+    """Return a content digest and byte count without storing raw messages."""
+    raw = json.dumps(value, ensure_ascii=False, sort_keys=True, default=str).encode("utf-8")
+    return hashlib.sha256(raw).hexdigest(), len(raw)
+
+
+def _tpr_diag_write(session: GatewaySession, record: dict[str, Any]) -> None:
+    """Best-effort per-session JSONL; never block normal execution on diagnostic errors."""
+    log_dir = session._metadata.get("_log_dir")
+    if not log_dir:
+        return
+    try:
+        directory = Path(log_dir)
+        directory.mkdir(parents=True, exist_ok=True)
+        with (directory / "gateway_requests.jsonl").open("a", encoding="utf-8") as output:
+            output.write(json.dumps(record, sort_keys=True, ensure_ascii=False) + "\n")
+    except OSError:
+        logger.warning("TPR Gateway diagnostic write failed for %s", log_dir, exc_info=True)
+
